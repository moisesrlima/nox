# Google OAuth (used by api/index.ts -> REQUIRED_ENVS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI configured in Google Cloud Console.
# Must match the route registered in api/index.ts -> router.get('/auth/callback')
# Local: http://localhost:3000/api/auth/callback
# Prod:  https://<your-domain>/api/auth/callback
GOOGLE_REDIRECT_URI=

# Gemini API key (consumed by Vite -> vite.config.ts define)
GEMINI_API_KEY=

# Optional Google Analytics 4 measurement id (VITE_* is exposed to the client)
VITE_GA_MEASUREMENT_ID=
